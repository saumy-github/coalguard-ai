# Base URL of the backend FastAPI service (see SETUP.md).
VITE_API_URL=http://localhost:8000

# Google OAuth Client ID. Google login is fully built end-to-end but disabled
# in the UI (GOOGLE_AUTH_ENABLED in src/pages/auth/Login.tsx) until this is a
# real Google Cloud OAuth Client ID — see research/saumy/02-google-auth-deferred.md.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
