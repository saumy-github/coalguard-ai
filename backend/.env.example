MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=coalguard
FRONTEND_URL=http://localhost:5173

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# ~10 years — sessions are meant to persist indefinitely ("log in once, stay logged in"),
# there's no refresh-token rotation. A leaked token stays valid until this expiry; there's
# no server-side revocation. Acceptable tradeoff for now, not for a real production system.
JWT_EXPIRE_MINUTES=5256000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Internal Docker DNS name — the ai_engine service, not localhost:8001 (that's the
# host-mapped port for calling it from outside Docker).
AI_ENGINE_URL=http://ai_engine:8000
