# ── Infra ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=coalguard_ledger

# ── Service-to-service auth ─────────────────────────────────────────────────
# Shared secret the backend sends as X-Ledger-Api-Key on write endpoints.
# Must match backend/.env's LEDGER_API_KEY.
LEDGER_API_KEY=change-me-to-a-long-random-string

# ── Chain — leave ANCHOR_ENABLED=false until you have a funded Sepolia wallet.
# The service, /health, and the anchor queue all work fine in this mode;
# entries just sit as "pending" until you flip this on.
ANCHOR_ENABLED=false
CHAIN_RPC_URL=
CHAIN_ID=11155111

# A FRESH THROWAWAY WALLET — never a personal MetaMask key. Get one with:
#   npm run chain:new-wallet   (or: node -e "console.log(require('ethers').Wallet.createRandom())")
# Fund it via the Google Cloud Web3 faucet or https://sepolia-faucet.pk910.de/
ANCHOR_PRIVATE_KEY=

# Filled in automatically by `npm run chain:deploy:sepolia` (see
# blockchain/deployments/sepolia.json) — override here only if you need to
# point at a different deployment than the committed one.
CONTRACT_ADDRESS=
# DEPLOYED_AT_BLOCK=

# ── Worker tuning (defaults are fine for a demo) ────────────────────────────
POLL_INTERVAL_SECONDS=3.0
# 1+ on Sepolia. Set to 0 when pointing at the local Hardhat node: it mines a
# block only when a transaction arrives, so the last anchor of a burst would
# wait forever for a confirmation block nothing will produce.
CONFIRMATIONS_REQUIRED=1
RECEIPT_TIMEOUT_SECONDS=180
MAX_BATCH_SIZE=50
BALANCE_WARNING_WEI=10000000000000000

ETHERSCAN_BASE_URL=https://sepolia.etherscan.io

# ── Deploy-time only (Hardhat reads these; the Python service never does) ────
# Needed just for `npm run chain:deploy:sepolia` and `npm run chain:verify`.
# Separate from ANCHOR_PRIVATE_KEY above on purpose: the deployer holds admin
# rights on the contract, the anchorer is the hot key that only submits. They
# can be the same wallet to start (leave ANCHORER_ADDRESS blank and the deploy
# grants the anchorer role to the deployer), but splitting them later is then
# a config change rather than a redeploy.
DEPLOYER_PRIVATE_KEY=

# Optional — defaults to the public node https://ethereum-sepolia-rpc.publicnode.com,
# which needs no signup and is fine for a handful of deploys. Set an
# Alchemy/Infura URL here if the public one rate-limits you.
SEPOLIA_RPC_URL=

# Optional — only for `npm run chain:verify`, which publishes the source on
# Etherscan so a judge can call verify() from a browser with no tooling.
# Free key: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional — address granted ANCHORER_ROLE at deploy time. Defaults to the
# deployer. Set it to the ANCHOR_PRIVATE_KEY wallet's address if you split them.
ANCHORER_ADDRESS=
